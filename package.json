{
  "name": "fansnap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync-mocks && next dev",
    "build": "npm run sync-mocks && next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run sync-mocks && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run sync-mocks && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run sync-mocks && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "sync-mocks": "node scripts/sync-mock-photos.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
