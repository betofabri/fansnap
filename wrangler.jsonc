/**
 * FanSnap — Cloudflare Workers config
 *
 * Docs:
 *   https://developers.cloudflare.com/workers/wrangler/configuration/
 *   https://opennext.js.org/cloudflare
 *
 * Bindings stubbed (commented) for Fatia 2 — D1 schema, R2 photo bucket, etc.
 * Uncomment & fill IDs when the resources are provisioned.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fansnap",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Keep the workers.dev URL alive as a debugging fallback alongside the custom domain.
	"workers_dev": true,
	// Custom URL: betofabri.com/fansnap (subpath on the personal domain).
	// Pair this with basePath: "/fansnap" in next.config.ts so all Next routes
	// (including /_next/static/*) line up.
	"routes": [
		{ "pattern": "betofabri.com/fansnap*", "zone_name": "betofabri.com" }
	],
	// "vars": {
	// 	"NEXT_PUBLIC_APP_ENV": "production"
	// }
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fansnap",
			"database_id": "d2c85059-7a8e-4db8-a5b8-3eca10a96cda"
		}
	],
	// Transactional email (env.EMAIL). Sends only work once betofabri.com is
	// onboarded to Email Sending (`wrangler email sending enable betofabri.com`
	// + DNS verification). Until then env.EMAIL.send() throws and src/lib/email
	// swallows it — declaring the binding is safe regardless.
	"send_email": [
		{ "name": "EMAIL" }
	],
	// Photo storage (env.PHOTOS). Originals under originals/<code>/<id>, public
	// watermarked previews under previews/<code>/<id>. Wired in Fase 0; consumed
	// from Fase 1 (upload) onward. Declaring it is safe even before any code uses it.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "fansnap-photos"
		}
	],
	// Processing pipeline (Fase 2a): each finished upload enqueues {photoId};
	// the fansnap-processor Worker (processor/) consumes, watermarks into
	// previews/ and flips the photo to 'published'.
	"queues": {
		"producers": [
			{ "binding": "PROCESS_QUEUE", "queue": "fansnap-process" }
		]
	},
	// "images": { "binding": "IMAGES" }
}
