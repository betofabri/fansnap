/**
 * FanSnap — Cloudflare Workers config
 *
 * Docs:
 *   https://developers.cloudflare.com/workers/wrangler/configuration/
 *   https://opennext.js.org/cloudflare
 *
 * Bindings stubbed (commented) for Fatia 2 — D1 schema, R2 photo bucket, etc.
 * Uncomment & fill IDs when the resources are provisioned.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fansnap",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Keep the workers.dev URL alive as a debugging fallback alongside the custom domain.
	"workers_dev": true,
	// Custom URL: betofabri.com/fansnap (subpath on the personal domain).
	// Pair this with basePath: "/fansnap" in next.config.ts so all Next routes
	// (including /_next/static/*) line up.
	"routes": [
		{ "pattern": "betofabri.com/fansnap*", "zone_name": "betofabri.com" }
	],
	// "vars": {
	// 	"NEXT_PUBLIC_APP_ENV": "production"
	// }
	// "d1_databases": [
	// 	{
	// 		"binding": "DB",
	// 		"database_name": "fansnap",
	// 		"database_id": "<FILL_AFTER_wrangler d1 create fansnap>"
	// 	}
	// ],
	// "r2_buckets": [
	// 	{
	// 		"binding": "PHOTOS",
	// 		"bucket_name": "fansnap-photos"
	// 	}
	// ],
	// "images": { "binding": "IMAGES" }
}
